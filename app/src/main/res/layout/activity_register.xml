<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_logo_tile">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_app" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"
                android:textColor="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Únete gratis"
                style="@style/Text.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crea tu cuenta"
                style="@style/Text.Display"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Empieza a liberar espacio en tu galería en segundos."
                style="@style/Text.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                style="@style/Text.Eyebrow" />

            <LinearLayout style="@style/FieldContainer" android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_user"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/editTextName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Tu nombre"
                    android:inputType="textPersonName"
                    android:textSize="15sp"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Correo electrónico"
                style="@style/Text.Eyebrow" />

            <LinearLayout style="@style/FieldContainer" android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_mail"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:textSize="15sp"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Contraseña"
                style="@style/Text.Eyebrow" />

            <LinearLayout style="@style/FieldContainer" android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Mínimo 6 caracteres"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/buttonTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_eye"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="Mostrar contraseña" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirmar contraseña"
                style="@style/Text.Eyebrow" />

            <LinearLayout style="@style/FieldContainer" android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/editTextConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Repite tu contraseña"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/buttonToggleConfirmPassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_eye"
                    android:tint="@color/colorTextTertiary"
                    android:contentDescription="Mostrar contraseña" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonRegister"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="28dp"
                android:text="Crear cuenta" />

            <TextView
                android:id="@+id/textViewLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:text="¿Ya tienes cuenta?  Iniciar sesión →"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="14.5sp"
                android:textColor="@color/colorAccent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
