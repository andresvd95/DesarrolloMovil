<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_logo_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_app" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:fontFamily="@font/poppins_bold"
                android:textSize="14.5sp"
                android:textColor="@color/colorTextPrimary" />

            <ImageButton
                android:id="@+id/buttonFilters"
                style="@style/IconButton.Circle"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_sliders"
                android:contentDescription="Filtros" />

            <ImageButton
                android:id="@+id/buttonOpenTrash"
                style="@style/IconButton.Circle"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_trash"
                android:contentDescription="Papelera" />

            <ImageButton
                android:id="@+id/buttonHome"
                android:layout_width="@dimen/size_icon_btn"
                android:layout_height="@dimen/size_icon_btn"
                android:background="@drawable/bg_circle_primary_gradient"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_home"
                android:tint="@color/white"
                android:elevation="2dp"
                android:contentDescription="Ir a inicio" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMediaCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            style="@style/Text.Subtitle"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <FrameLayout
            android:id="@+id/cardMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_media"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/imageMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim_bottom" />

            <TextView
                android:id="@+id/stampKeep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="22dp"
                android:background="@drawable/bg_stamp_keep"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="CONSERVAR"
                android:fontFamily="@font/poppins_extrabold"
                android:textSize="15sp"
                android:letterSpacing="0.05"
                android:textColor="@color/colorAccent"
                android:rotation="-14"
                android:alpha="0" />

            <TextView
                android:id="@+id/stampTrash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="22dp"
                android:background="@drawable/bg_stamp_trash"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="ELIMINAR"
                android:fontFamily="@font/poppins_extrabold"
                android:textSize="15sp"
                android:letterSpacing="0.05"
                android:textColor="@color/colorDangerEnd"
                android:rotation="14"
                android:alpha="0" />

            <!-- Miniguia permanente de gestos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_hint_chip"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="#FFFF8B96"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Eliminar"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="9.5sp"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_hint_chip"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#FF6FE3F2"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Conservar"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="9.5sp"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_hint_chip"
                    android:padding="7dp"
                    android:src="@drawable/ic_chevron_up"
                    android:tint="#E6FFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Después"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="9sp"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textMediaName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text=""
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="17sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/textMediaMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="13sp"
                    android:textColor="#B8FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/textVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_button_ghost"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="22dp"
                android:paddingBottom="12dp"
                android:text="▶ Reproducir video"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:visibility="gone" />

            <VideoView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/buttonCloseVideo"
                style="@style/IconButton.Circle"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:contentDescription="Cerrar video" />
        </FrameLayout>

        <TextView
            android:id="@+id/textEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="32dp"
            android:gravity="center"
            android:text="Cargando galería…"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/colorTextSecondary"
            android:textSize="15sp"
            android:visibility="visible" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="Desliza o toca los botones"
        style="@style/Text.Caption" />

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/buttonUndo"
                android:layout_width="@dimen/size_action_secondary"
                android:layout_height="@dimen/size_action_secondary"
                android:background="@drawable/bg_icon_circle"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_undo"
                android:tint="@color/colorTextSecondary"
                android:enabled="false"
                android:contentDescription="Deshacer" />

            <ImageButton
                android:id="@+id/buttonTrash"
                android:layout_width="@dimen/size_action_medium"
                android:layout_height="@dimen/size_action_medium"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_circle_danger_gradient"
                android:padding="15dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_trash"
                android:tint="@color/white"
                android:elevation="2dp"
                android:contentDescription="Eliminar" />
        </LinearLayout>

        <View
            android:layout_width="34dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/buttonKeep"
            android:layout_width="@dimen/size_action_primary"
            android:layout_height="@dimen/size_action_primary"
            android:background="@drawable/bg_circle_primary_gradient"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_check"
            android:tint="@color/white"
            android:elevation="4dp"
            android:contentDescription="Conservar" />
    </LinearLayout>

</LinearLayout>
