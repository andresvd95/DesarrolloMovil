<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilos de widgets base: aplican Poppins a toda la app por defecto -->
    <style name="Widget.App.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
    </style>

    <!-- Escala tipografica reutilizable -->
    <style name="Text.Eyebrow" parent="">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:textColor">@color/colorTextTertiary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Display" parent="">
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/colorTextTertiary</item>
    </style>

    <!-- Botones de marca -->
    <style name="Button.Primary" parent="Widget.App.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Ghost" parent="Widget.App.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Danger" parent="Widget.App.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="IconButton.Circle" parent="">
        <item name="android:layout_width">@dimen/size_icon_btn</item>
        <item name="android:layout_height">@dimen/size_icon_btn</item>
        <item name="android:background">@drawable/bg_icon_circle</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/colorTextSecondary</item>
    </style>

    <style name="FieldContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
