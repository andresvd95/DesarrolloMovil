<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurfaceElevated" />
            <stroke android:width="@dimen/stroke_focus" android:color="@color/colorAccent" />
            <corners android:radius="@dimen/radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurfaceElevated" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/colorBorder" />
            <corners android:radius="@dimen/radius_field" />
        </shape>
    </item>
</selector>
